# ==========================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to .env and fill in with REAL values
# IMPORTANT: .env should NEVER be committed to git
# The .gitignore file prevents .env from being tracked
# Only .env.example is safe to commit (as a template)
# ==========================================

# Database Configuration
# Use your actual production database credentials here
DB_HOST=your-production-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASS=your-secure-database-password
DB_NAME=datacamp

# Server Configuration
PORT=3000
NODE_ENV=production

# ==========================================
# SECURITY NOTES:
# ==========================================
# 1. On Railway: Go to Variables tab and paste your real values
# 2. Locally: Create .env file from this template (git-ignored)
# 3. NEVER commit .env with real credentials
# 4. Keep DB_PASS strong and unique
# 5. Use environment variables for all sensitive data
# ==========================================
