{
  "version": 2,
  "buildCommand": "cd backend && npm install",
  "public": false,
  "functions": {
    "backend/src/server.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "backend/src/server.js"
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/backend/src/server.js"
    }
  ]
}
