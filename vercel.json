{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [

        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://placehold.co data: blob:; font-src 'self'; connect-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },

        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },

        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },

        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },

        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), ambient-light-sensor=(), autoplay=(), fullscreen=(self), picture-in-picture=(self)"
        },

        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },

        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },

        {
          "key": "X-Powered-By",
          "value": ""
        }

      ]
    },

    {
      "source": "/(signin|signup|dashboard|activity|pings|hey|lineup|my-stuff|find)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, private, max-age=0"
        }
      ]
    },

    {
      "source": "/css/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    },

    {
      "source": "/js/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    },

    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }

  ]
}
